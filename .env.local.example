# Salin file ini menjadi .env.local lalu isi dengan data dari database Turso Anda.
# Cara mendapatkan nilainya ada di README.md, bagian "Setup database Turso".
#
# TURSO_DATABASE_URL didapat dari: turso db show nama-database-anda --url
# TURSO_AUTH_TOKEN didapat dari:   turso db tokens create nama-database-anda

TURSO_DATABASE_URL=libsql://nama-database-anda-username.turso.io
TURSO_AUTH_TOKEN=isi-dengan-token-dari-turso
